/* GAYA DASAR & TEMA WARNA SOFT PINK */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fce4ec;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    color: #424242; /* Warna teks utama */
}

main {
    padding: 20px;
}

/* 1. GAYA LOGIN (index.html) */
.login-container {
    background-color: #ffffff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 6px 15px rgba(233, 30, 99, 0.1);
    width: 100%;
    max-width: 350px;
    margin: 10vh auto 0 auto;
    text-align: center;
}

.login-container h1 {
    color: #e91e63;
    margin-bottom: 30px;
    font-size: 28px;
}

/* Grup Input dengan garis bawah */
.input-group {
    margin-bottom: 25px;
    position: relative;
    border-bottom: 2px solid #f06292;
}

.input-group input {
    width: 100%;
    padding: 12px 10px 12px 0;
    border: none;
    outline: none;
    font-size: 16px;
    box-sizing: border-box;
    background: transparent;
}

/* Tautan Lupa Password dan Daftar */
.forgot-password {
    text-align: right;
    margin-top: -5px;
    margin-bottom: 25px;
}

.forgot-password a, .register-link a {
    color: #e91e63;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s;
}

.forgot-password a:hover, .register-link a:hover {
    color: #c2185b;
}

/* Tombol Masuk/Login */
.btn-login {
    width: 100%;
    padding: 15px;
    background-color: #e91e63;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.2s;
    font-weight: bold;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.btn-login:hover {
    background-color: #c2185b;
    transform: translateY(-2px);
}


/* 2. GAYA NAVBAR/HEADER (dashboard.html, tracking.html, stok.html)*/
.navbar, .navigation-bar { /* Menggunakan kedua class untuk fleksibilitas */
    background-color: #e91e63;
    color: white;
    padding: 0 20px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    display: flex;
}

.nav-links {
    display: flex;
    margin: 0;
    padding: 0;
}

.nav-item {
    display: block;
    padding: 15px 20px;
    color: white;
    text-decoration: none;
    transition: background-color 0.3s;
    font-size: 16px;
    cursor: pointer;
    border: none;
    background: none;
    text-align: left;
    font-weight: 500;
}

.nav-item:hover, .dropdown-btn:hover {
    background-color: #c2185b;
}

/* Dropdown */
.dropdown {
    position: relative;
    display: inline-block;
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: #ffffff;
    min-width: 250px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 10;
    border-radius: 4px;
    overflow: hidden;
}

.dropdown-content a {
    color: #424242;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    text-align: left;
}

.dropdown-content a:hover {
    background-color: #fce4ec;
    color: #e91e63;
}

.dropdown:hover .dropdown-content {
    display: block;
}

/* 3. GAYA DASHBOARD (dashboard.html)*/
.dashboard-content {
    max-width: 1000px;
    margin: 20px auto;
    padding: 30px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
}

.dashboard-content h2 {
    color: #e91e63;
    border-bottom: 2px solid #fce4ec;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.greeting {
    font-size: 1.5em;
    font-weight: 600;
    color: #e91e63;
    margin-top: 10px;
}

/* 4. GAYA TRACKING (tracking.html)*/
.tracking-container {
    max-width: 800px;
    margin: 20px auto;
    padding: 30px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
}

.search-area {
    display: flex;
    gap: 10px;
    margin-bottom: 30px;
}

.search-area input {
    flex-grow: 1;
    padding: 12px;
    border: 1px solid #f06292;
    border-radius: 8px;
    font-size: 16px;
}

.search-area button {
    padding: 12px 25px;
    background-color: #e91e63;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.search-area button:hover {
    background-color: #c2185b;
}

/* Header Detail Tracking */
.tracking-header {
    background-color: #e91e63;
    color: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 25px;
}

.tracking-header h3 {
    margin: 0 0 8px 0;
    font-size: 1.8em;
}

/* Timeline */
.timeline {
    position: relative;
    padding: 10px 0;
}

.timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20px;
    bottom: 0;
    width: 3px;
    background-color: #f06292;
}

.timeline-item {
    position: relative;
    margin-left: 50px;
    padding-bottom: 25px;
}

.timeline-item::before {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #e91e63;
    border: 3px solid #ffffff;
    left: -29px;
    top: 5px;
    z-index: 1;
}

.timeline-item.delivered::before {
    background-color: #4CAF50;
}

.timeline-content {
    padding: 10px 15px;
    border-radius: 6px;
    background-color: #fce4ec;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.timeline-date {
    font-size: 0.9em;
    color: #e91e63;
    font-weight: bold;
}


   /* 5. GAYA STOK (stok.html) */
.stok-container {
    max-width: 700px;
    margin: 20px auto;
    padding: 30px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
}

.add-btn {
    padding: 10px 15px;
    background-color: #f06292;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-bottom: 25px;
    font-weight: 500;
}

.add-btn:hover {
    background-color: #e91e63;
}

/* Kartu Data */
.data-card {
    border: 1px solid #f06292;
    border-radius: 8px;
    margin-bottom: 25px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.card-header {
    background-color: #fce4ec;
    color: #e91e63;
    padding: 15px;
    text-align: center;
    font-size: 1.1em;
}

.card-image {
    background-color: #ffebee;
    padding: 20px;
    text-align: center;
    color: #e91e63;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 15px;
    border-bottom: 1px solid #fce4ec;
}

.detail-label {
    font-weight: bold;
    color: #666;
    min-width: 150px;
    text-align: left;
    content: ": ";
}

.detail-row span:last-child {
    font-weight: normal;
    color: #424242;
    text-align: right;
}

.detail-label::after {
    content: ": ";
}

/* Form Tambah Stok */
.form-card {
    border: 2px dashed #f06292;
    padding: 25px;
    margin-bottom: 30px;
    border-radius: 8px;
    background-color: #fff8fb;
}

.form-card h3 {
    color: #e91e63;
    margin-top: 0;
}

.form-card input {
    width: calc(100% - 22px);
    padding: 10px;
    margin-bottom: 12px;
    border: 1px solid #f06292;
    border-radius: 4px;
}

.form-card button#submitStokBtn {
    background-color: #4CAF50; /* Warna hijau untuk aksi 'Simpan' */
}

.form-card button#submitStokBtn:hover {
    background-color: #45a049;
}
